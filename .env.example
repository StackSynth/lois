GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=6000
OCR_TIMEOUT_MS=30000
GEMINI_OCR_TIMEOUT_MS=28000
GEMINI_OCR_RETRY_TIMEOUT_MS=18000
OCR_WARMUP_TIMEOUT_MS=8000
OCR_MAX_EDGE=1024
OCR_FAST_EDGE=768
# Keep false in Vercel. Tesseract is CPU-heavy; Gemini Vision is the deployed OCR provider.
OCR_FALLBACK_TESSERACT=false
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001
PORT=3001
